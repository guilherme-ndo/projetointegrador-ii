model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["PastaDados","_Medidas","dCalendario","dMunicipio","dArea","dCBO","dEscolaridade","fOfertaEnsino","fAdmissoes","fEstoqueEmprego","fPopulacao","fFormadosResidentes","fFrequenciaEscolar"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

ref table _Medidas
ref table dCalendario
ref table dMunicipio
ref table dArea
ref table dCBO
ref table dEscolaridade
ref table fOfertaEnsino
ref table fAdmissoes
ref table fEstoqueEmprego
ref table fPopulacao
ref table fFormadosResidentes
ref table fFrequenciaEscolar

